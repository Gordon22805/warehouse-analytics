POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=warehouse_analytics
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=warehouse_pass

# Superset: BI-слой поверх тех же views.
# Метаданные Superset живут в отдельной базе того же сервера PostgreSQL.
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=change_me_in_production
SUPERSET_META_URI=postgresql+psycopg2://warehouse_user:warehouse_pass@host.docker.internal:5433/superset_meta
WAREHOUSE_URI=postgresql+psycopg2://warehouse_user:warehouse_pass@host.docker.internal:5433/warehouse_analytics
